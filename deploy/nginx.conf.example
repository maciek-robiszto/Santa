# /etc/nginx/sites-available/mikolajki  →  ln -s ../sites-available/mikolajki /etc/nginx/sites-enabled/
# Następnie: nginx -t && systemctl reload nginx && certbot --nginx -d mikolaj.robisz.to
server {
    listen 80;
    server_name mikolaj.robisz.to;

    # Bez logów dostępu: tokeny zaproszeń i resetu nie trafiają do logów.
    access_log off;
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
