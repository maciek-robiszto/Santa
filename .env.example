# Domena (dla Caddy / HTTPS) i pełny adres aplikacji
DOMAIN=mikolajki.example.pl
APP_URL=https://mikolajki.example.pl

# 32 bajty w base64: npm run gen-key
# PRZECHOWUJ OSOBNO OD KOPII BAZY. Utrata klucza = utrata par i profili.
ENCRYPTION_KEY=

SITE_NAME=Makerskie Mikołajki

# Opcjonalnie: powiadomienia e-mail i reset hasła mailem
# SMTP_URL=smtps://user:haslo@smtp.example.pl:465
# MAIL_FROM="Makerskie Mikołajki <mikolajki@example.pl>"

# SESSION_DAYS=30

# Samoobsługa: każdy może założyć konto i własną grupę dla znajomych.
# OPEN_REGISTRATION=true        # false = konta tylko przez link z zaproszeniem
# GROUP_CREATION=everyone       # admins = grupy tworzy tylko superadmin
# MAX_GROUPS_PER_USER=10
# MAX_PARTICIPANTS=200
